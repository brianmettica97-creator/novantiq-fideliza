# Copiá este archivo como .env.local y completá los valores de tu proyecto Supabase.
# Estas dos claves son PÚBLICAS (van al navegador). La seguridad la dan RLS y las funciones del servidor.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (para enlaces de inscripción, invitaciones y retorno de pagos)
VITE_SITE_URL=http://localhost:5173

# Opcional: Cloudflare Turnstile (anti-bots en registro). Configurar también en Supabase > Auth > Captcha.
VITE_TURNSTILE_SITE_KEY=

# NUNCA pongas aquí la service_role key ni el access token de Mercado Pago.
# Esos secretos van en Supabase: `supabase secrets set ...` (ver README).
